#!/bin/sh
privacy_python=$(git config --local --get privacy.python)
if [ -n "$privacy_python" ]; then
  exec "$privacy_python" tools/privacy_check.py
fi
if command -v python >/dev/null 2>&1; then
  exec python tools/privacy_check.py
elif command -v python3 >/dev/null 2>&1; then
  exec python3 tools/privacy_check.py
else
  echo "Privacy check requires Python. Commit blocked." >&2
  exit 1
fi
